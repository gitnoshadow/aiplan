# Railway injects PORT and DATABASE_URL (reference the Postgres service variable).
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/voiceplan

# Google OAuth client (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud.
OAUTH_REDIRECT_URL=https://your-service.up.railway.app/auth/callback

# The only Google account allowed to sign in.
ALLOWED_EMAIL=you@example.com

# >= 32 random chars. Generate: openssl rand -base64 48
SESSION_SECRET=
# base64 of exactly 32 random bytes; encrypts the stored Google refresh token.
# Generate: openssl rand -base64 32   (keep it stable: changing it invalidates stored tokens)
ENCRYPTION_KEY=

# Public origin of the app, no trailing slash. https:// turns on Secure cookies.
APP_BASE_URL=https://your-service.up.railway.app

# Gemini API (plan parsing + voice transcription). Key from Google AI Studio.
GEMINI_API_KEY=
# Model name is never hard-coded. Needs audio input + structured output.
# Verified against Google's docs on 2026-09-30: gemini-3.7-flash
LLM_MODEL=gemini-3.7-flash

# Optional: tried automatically if LLM_MODEL stays overloaded (503/429) after retries.
# Example: gemini-3.1-flash-lite (check it accepts audio if you use voice input).
LLM_FALLBACK_MODEL=

# LINE Messaging API (LINE Developers Console -> your channel)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Optional LINE settings
# Monthly message quota (free plan = 200). 0 = do not enforce.
LINE_MONTHLY_LIMIT=200
# Add-friend link used in invitations: https://line.me/R/ti/p/@<Bot basic ID>
LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@191xcckr

# How often to pull changes made directly in Google Calendar (minutes, 1-60).
CALENDAR_SYNC_MINUTES=5
