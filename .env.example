# Railway injects PORT and DATABASE_URL (reference the Postgres service variable).
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/voiceplan

# Google OAuth client (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud.
OAUTH_REDIRECT_URL=https://your-service.up.railway.app/auth/callback

# The only Google account allowed to sign in.
ALLOWED_EMAIL=you@example.com

# >= 32 random chars. Generate: openssl rand -base64 48
SESSION_SECRET=
# base64 of exactly 32 random bytes; encrypts the stored Google refresh token.
# Generate: openssl rand -base64 32   (keep it stable: changing it invalidates stored tokens)
ENCRYPTION_KEY=

# Public origin of the app, no trailing slash. https:// turns on Secure cookies.
APP_BASE_URL=https://your-service.up.railway.app

# Gemini API (plan parsing + voice transcription). Key from Google AI Studio.
GEMINI_API_KEY=
# Model name is never hard-coded. Pick a current model that supports audio input
# and JSON-schema structured output (see Google AI Studio's model list).
LLM_MODEL=
